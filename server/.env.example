PORT=5000
NODE_ENV=production
JWT_SECRET=change_this_to_a_very_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-domain.com

# On first startup, if no owner account exists yet, ONE is created
# automatically from these values, along with demo data (medications,
# staff, suppliers, customers). Just set them, deploy, and log in.
DEMO_USERNAME=tap
DEMO_PASSWORD=CHANGE_ME
DEMO_NAME=اسم الصيدلي
DEMO_PHARMACY_NAME=اسم الصيدلية
